<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFDF8"
    android:paddingTop="24dp">

    <!-- 🛕 Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="20dp">
        
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Utsav Expenses"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"/>
            
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_secure_shield" 
            app:tint="#D32F2F"
            tools:ignore="MissingPrefix" />
    </LinearLayout>

    <!-- 📉 Premium Financial Dashboard Card (Red Tint for Expenses) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#FFEBEE"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#FFCDD2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL UTSAV BURN"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#C62828"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvTotalExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="৳ 0.00"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#B71C1C"
                android:fontFamily="sans-serif-black"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 🔒 RBAC SECURE ACTION ROW (For Admins Only) -->
    <LinearLayout
        android:id="@+id/adminControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddExpense"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="64dp"
            android:text="+ LOG EXPENSE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            app:cornerRadius="16dp"
            app:elevation="2dp"
            android:layout_marginHorizontal="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportMaster"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="64dp"
            android:text="MASTER PDF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#455A64"
            app:strokeColor="#CFD8DC"
            app:strokeWidth="2dp"
            app:cornerRadius="16dp"
            android:layout_marginHorizontal="6dp" />
    </LinearLayout>

    <!-- 🔍 Search & Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginEnd="12dp">
            
            <EditText
                android:id="@+id/inputSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Search Event or Item..."
                android:textColorHint="#9E9E9E"
                android:textColor="#212121"
                android:textSize="15sp"
                android:background="@null"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:ellipsize="end" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterDates"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:icon="@drawable/ic_calendar" 
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="#F26522"
            app:cornerRadius="14dp"
            app:elevation="2dp" />
    </LinearLayout>

    <!-- 📜 The Ledger List (Offline Ready Scroll) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <!-- Java injects item_expense.xml rows in here -->
        <LinearLayout
            android:id="@+id/expensesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp" />
            
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
